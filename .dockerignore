# Version control
.git
.gitignore

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment & secrets
.env
.env.*

# Editor/IDE
.vscode/
.idea/

# Reference-only file (gitignored, uses `requests` which isn't installed) —
# not part of the deployed app, keep it out of the image.
player_lookup_full.py

# Tests, dev-only deps, and CI config — not part of the runtime image.
# (The Dockerfile's COPY is already explicit and would skip these anyway;
# this just keeps them out of the build context sent to the daemon.)
tests/
conftest.py
requirements-dev.txt
.github/
.pytest_cache/

# Local data / OS cruft
*.db
*.sqlite
*.sqlite3
.DS_Store
